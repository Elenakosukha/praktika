class Animal:
    def speak(self):
        return "Animal sound"

class Cat(Animal):
    def speak(self):
        return "Meow!"

def main():
    # Создаем экземпляр базового класса
    generic_animal = Animal()
    print("Generic animal says:", generic_animal.speak())

    # Создаем экземпляр производного класса
    my_cat = Cat()
    print("My cat says:", my_cat.speak())

if __name__ == "__main__":
    main()
